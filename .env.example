# Get a free key at https://aistudio.google.com/apikey  (server-side only, never exposed to the browser)
GEMINI_API_KEY=
# Optional: override the model (check your free-tier limits in AI Studio)
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: MOCK_LLM=1 serves canned plans so you can work on the UI without a key
MOCK_LLM=
