# Get a free key at https://aistudio.google.com/apikey  (server-side only, never exposed to the browser)
GEMINI_API_KEY=
# Optional: override the models (free tier: 3.5 Flash-Lite = 15 RPM / 500 RPD; check AI Studio > Rate Limit)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional: MOCK_LLM=1 serves canned plans so you can work on the UI without a key
MOCK_LLM=
